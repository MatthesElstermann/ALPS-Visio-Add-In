        <rdf:type rdf:resource="&standard-pass-ont;SendTransitionCondition"/>
        <standard-pass-ont:hasModelComponentID rdf:datatype="&xsd;string">M_SendTrans_Deny_Cond</standard-pass-ont:hasModelComponentID>
        <standard-pass-ont:hasModelComponentLabel xml:lang="en">M_SendTrans_Deny_Cond</standard-pass-ont:hasModelComponentLabel>
        <standard-pass-ont:requiresPerformedMessageExchange rdf:resource="http://alps-visio-test.example/autolayout-test#MsgExchange_Denial"/>
        <standard-pass-ont:requiresMessageSentTo rdf:resource="http://alps-visio-test.example/autolayout-test#Subject_Employee"/>
        <standard-pass-ont:requiresSendingOfMessage rdf:resource="http://alps-visio-test.example/autolayout-test#MsgSpec_Denial"/>
        <standard-pass-ont:hasSendType rdf:resource="http://www.i2pm.net/standard-pass-ont#SendTypeStandard"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://alps-visio-test.example/autolayout-test#M_DoState_End">
        <rdf:type rdf:resource="&standard-pass-ont;DoState"/>
        <rdf:type rdf:resource="&standard-pass-ont;EndState"/>
        <standard-pass-ont:hasModelComponentID rdf:datatype="&xsd;string">M_DoState_End</standard-pass-ont:hasModelComponentID>
        <standard-pass-ont:hasModelComponentLabel xml:lang="en">End</standard-pass-ont:hasModelComponentLabel>
    </owl:NamedIndividual>

