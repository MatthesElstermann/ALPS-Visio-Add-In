        <standard-pass-ont:hasModelComponentID rdf:datatype="&xsd;string">M_SendTrans_Approve</standard-pass-ont:hasModelComponentID>
        <standard-pass-ont:hasModelComponentLabel xml:lang="en">To: Employee&#10;Msg: Approval</standard-pass-ont:hasModelComponentLabel>
        <standard-pass-ont:hasSourceState rdf:resource="http://alps-visio-test.example/autolayout-test#M_SendState_Approve"/>
        <standard-pass-ont:hasTargetState rdf:resource="http://alps-visio-test.example/autolayout-test#M_DoState_End"/>
        <standard-pass-ont:hasPriorityNumber rdf:datatype="&xsd;positiveInteger">1</standard-pass-ont:hasPriorityNumber>
        <standard-pass-ont:hasTransitionCondition rdf:resource="http://alps-visio-test.example/autolayout-test#M_SendTrans_Approve_Cond"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://alps-visio-test.example/autolayout-test#M_SendTrans_Approve_Cond">
        <rdf:type rdf:resource="&standard-pass-ont;SendTransitionCondition"/>
        <standard-pass-ont:hasModelComponentID rdf:datatype="&xsd;string">M_SendTrans_Approve_Cond</standard-pass-ont:hasModelComponentID>
        <standard-pass-ont:hasModelComponentLabel xml:lang="en">M_SendTrans_Approve_Cond</standard-pass-ont:hasModelComponentLabel>
        <standard-pass-ont:requiresPerformedMessageExchange rdf:resource="http://alps-visio-test.example/autolayout-test#MsgExchange_Approval"/>
        <standard-pass-ont:requiresMessageSentTo rdf:resource="http://alps-visio-test.example/autolayout-test#Subject_Employee"/>
        <standard-pass-ont:requiresSendingOfMessage rdf:resource="http://alps-visio-test.example/autolayout-test#MsgSpec_Approval"/>
        <standard-pass-ont:hasSendType rdf:resource="http://www.i2pm.net/standard-pass-ont#SendTypeStandard"/>
    </owl:NamedIndividual>

    <!-- Branch: deny -->
    <owl:NamedIndividual rdf:about="http://alps-visio-test.example/autolayout-test#M_DoTrans_Deny">
        <rdf:type rdf:resource="&standard-pass-ont;DoTransition"/>
        <standard-pass-ont:hasModelComponentID rdf:datatype="&xsd;string">M_DoTrans_Deny</standard-pass-ont:hasModelComponentID>
        <standard-pass-ont:hasModelComponentLabel xml:lang="en">deny</standard-pass-ont:hasModelComponentLabel>
        <standard-pass-ont:hasSourceState rdf:resource="http://alps-visio-test.example/autolayout-test#M_DoState_Review"/>
        <standard-pass-ont:hasTargetState rdf:resource="http://alps-visio-test.example/autolayout-test#M_SendState_Deny"/>
        <standard-pass-ont:hasPriorityNumber rdf:datatype="&xsd;positiveInteger">2</standard-pass-ont:hasPriorityNumber>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://alps-visio-test.example/autolayout-test#M_SendState_Deny">
        <rdf:type rdf:resource="&standard-pass-ont;SendState"/>
        <standard-pass-ont:hasModelComponentID rdf:datatype="&xsd;string">M_SendState_Deny</standard-pass-ont:hasModelComponentID>
        <standard-pass-ont:hasModelComponentLabel xml:lang="en">Send denial</standard-pass-ont:hasModelComponentLabel>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://alps-visio-test.example/autolayout-test#M_SendTrans_Deny">
        <rdf:type rdf:resource="&standard-pass-ont;SendTransition"/>
        <standard-pass-ont:hasModelComponentID rdf:datatype="&xsd;string">M_SendTrans_Deny</standard-pass-ont:hasModelComponentID>
        <standard-pass-ont:hasModelComponentLabel xml:lang="en">To: Employee&#10;Msg: Denial</standard-pass-ont:hasModelComponentLabel>
        <standard-pass-ont:hasSourceState rdf:resource="http://alps-visio-test.example/autolayout-test#M_SendState_Deny"/>
        <standard-pass-ont:hasTargetState rdf:resource="http://alps-visio-test.example/autolayout-test#M_DoState_End"/>
        <standard-pass-ont:hasPriorityNumber rdf:datatype="&xsd;positiveInteger">1</standard-pass-ont:hasPriorityNumber>
        <standard-pass-ont:hasTransitionCondition rdf:resource="http://alps-visio-test.example/autolayout-test#M_SendTrans_Deny_Cond"/>
    </owl:NamedIndividual>

